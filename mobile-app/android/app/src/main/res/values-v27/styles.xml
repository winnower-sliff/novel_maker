<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 与 values/styles.xml 的同名主题保持一致，仅追加 API 27+ 的导航栏深色图标 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/nm_sepia</item>
        <item name="android:statusBarColor">@color/nm_sepia</item>
        <item name="android:navigationBarColor">@color/nm_sepia</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
