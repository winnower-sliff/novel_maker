{
  "name": "novel-maker",
  "version": "3.0.0-alpha.0",
  "description": "手机小说工坊（v2）：纯 Node 服务器 + 托盘 + 手机 APP，OpenAI 协议，导演式 agent",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "systray": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
