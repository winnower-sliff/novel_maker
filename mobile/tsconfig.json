{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@mobile/*": ["./src/*"],
      "@wizard/*": ["../src/wizard/*"],
      "@renderer/*": ["../src/renderer/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../src/shared/**/*.ts", "../src/wizard/**/*.ts*"]
}
